<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>异乡早咖啡 {{ date_str }}</title>
<style>
  @font-face {
    font-family: 'PuHuiTi';
    src: url('../fonts/AlibabaPuHuiTi-3-55-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'PuHuiTi';
    src: url('../fonts/AlibabaPuHuiTi-3-85-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'Montserrat';
    src: url('../fonts/Montserrat-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Montserrat';
    src: url('../fonts/Montserrat-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --theme: {{ theme.primary }};
    --accent: {{ theme.accent }};
    --hero-fg: {{ theme.hero_fg }};
    --hero-rule: {{ theme.hero_rule }};
    --hero-hl: {{ theme.hero_hl }};
    --uhomes-red: #FF5A5F;
    --pay-blue: #1890F8;
    --ink: #1A1D1F;
    --ink-soft: #4B5563;
    --ink-mute: #9CA3AF;
    --rule: #E5E7EB;
    --bg: #FFFFFF;
  }

  /* 数字/关键词自动高亮 */
  .hero .hl {
    color: var(--hero-hl);
    font-weight: 700;
  }
  .news-body .hl {
    color: var(--accent);
    font-weight: 700;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    font-family: 'Montserrat', 'PuHuiTi', -apple-system, sans-serif;
    color: var(--ink);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .poster {
    width: 1080px;
    background: var(--bg);
  }

  /* ── HERO: 1080×1080 红底白字 ── */
  .hero {
    width: 1080px;
    /* 自适应高度：文案短就保底 1080，长时自动扩张 */
    min-height: 1080px;
    background: var(--theme);
    color: var(--hero-fg);
    /* 顶部预留 140px 手机状态栏安全区（iPhone 全屏看图时 时间/电量 会覆盖顶部） */
    padding: 140px 72px 96px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: -120px; bottom: -120px;
    width: 480px; height: 480px;
    border-radius: 50%;
    background: var(--hero-fg);
    opacity: 0.06;
  }

  /* 有图版：封面图作为 hero 顶部 banner */
  .hero-cover {
    margin: -140px -72px 40px;   /* 撑满 hero 宽度，顶到顶（覆盖掉 padding-top 的安全区） */
    height: 560px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .hero-cover::after {
    /* 底部渐变：让从封面到 hero 主色块过渡自然 */
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0; height: 160px;
    background: linear-gradient(to bottom, transparent, var(--theme));
  }

  /* 无图版：从标题抽第一个数字做巨型水印装饰（出血到 hero 右下角，部分被裁剪） */
  .hero-stat {
    position: absolute;
    right: -48px; bottom: -72px;
    font-family: 'Montserrat';
    font-weight: 900;
    font-size: 500px;
    line-height: 0.85;
    color: var(--hero-fg);
    opacity: 0.16;
    letter-spacing: -22px;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.92;
  }
  .hero-brand-zh {
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 2px;
  }
  .hero-kicker {
    margin-top: 56px;
    font-family: 'PuHuiTi';
    font-weight: 400;
    font-size: 28px;
    letter-spacing: 4px;
    opacity: 0.82;
  }
  .hero-title {
    margin-top: 28px;
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 86px;
    line-height: 1.2;
    letter-spacing: -1px;
    max-width: 920px;
  }
  .hero-en {
    margin-top: 28px;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 24px;
    line-height: 1.5;
    opacity: 0.72;
    max-width: 920px;
  }
  .hero-summary {
    margin-top: 44px;
    font-family: 'PuHuiTi';
    font-weight: 400;
    font-size: 30px;
    line-height: 1.65;
    letter-spacing: 0.3px;
    max-width: 920px;
    opacity: 0.94;
    z-index: 1;
  }
  .hero-punch {
    margin-top: auto;
    padding-top: 40px;
    border-top: 3px solid var(--hero-rule);
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 34px;
    line-height: 1.5;
    max-width: 920px;
    z-index: 1;
  }
  .hero-source {
    margin-top: 20px;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 20px;
    opacity: 0.6;
    letter-spacing: 1px;
  }

  /* ── SECTION HEADER ── */
  .section-head {
    padding: 64px 72px 28px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .section-bar {
    width: 10px; height: 42px;
    background: var(--accent);
  }
  .section-title {
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 38px;
    color: var(--ink);
    letter-spacing: -0.5px;
  }
  .section-sub {
    margin-left: auto;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 20px;
    color: var(--ink-mute);
    letter-spacing: 2px;
  }

  /* ── NEWS CARDS ── */
  .news-list {
    padding: 0 72px;
  }
  .news-item {
    display: flex;
    gap: 28px;
    padding: 36px 0;
    border-bottom: 1px solid var(--rule);
  }
  .news-item:last-child { border-bottom: none; }
  .news-num {
    flex: 0 0 72px;
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 64px;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -2px;
  }
  .news-body { flex: 1; min-width: 0; }
  .news-title-zh {
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 36px;
    color: var(--ink);
    line-height: 1.35;
    letter-spacing: -0.5px;
  }
  .news-title-en {
    margin-top: 10px;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 20px;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .news-summary {
    margin-top: 16px;
    font-family: 'PuHuiTi';
    font-weight: 400;
    font-size: 26px;
    color: #2C3033;
    line-height: 1.6;
  }
  .news-source {
    margin-top: 14px;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 17px;
    color: var(--ink-mute);
    letter-spacing: 0.5px;
  }

  /* ── BRAND BAR ── */
  .brand-bar {
    margin-top: 56px;
    padding: 44px 72px;
    background: #F9FAFB;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    align-items: center;
    gap: 48px;
  }
  .brand-divider {
    width: 1px;
    height: 120px;
    background: #E5E7EB;
  }
  .brand-cell {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .brand-cell--right {
    justify-content: flex-end;
    flex-direction: row-reverse;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .brand-cell--right .brand-text { text-align: right; align-items: flex-end; }
  .brand-logo {
    display: block;
    height: 52px;
    width: auto;
    max-width: 280px;
    object-fit: contain;
  }
  /* 好居是纯字体 logo，视觉偏粗，缩一档配平 */
  .brand--uhomes .brand-logo { height: 46px; }
  /* 无 logo 时的文字回退（保留，不走这条路就不显示） */
  .brand-name {
    font-family: 'PuHuiTi';
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.5px;
    line-height: 1.1;
  }
  .brand--uhomes .brand-name { color: var(--uhomes-red); }
  .brand--pay    .brand-name { color: var(--pay-blue); }
  .brand-slogan {
    font-family: 'PuHuiTi';
    font-weight: 400;
    font-size: 16px;
    color: var(--ink-soft);
    letter-spacing: 1.5px;
  }
  .brand-tag {
    font-family: 'Montserrat';
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--ink-mute);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .qr {
    width: 132px; height: 132px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 4px 16px rgba(44, 48, 51, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .qr img {
    width: 118px;
    height: 118px;
    object-fit: contain;
    display: block;
  }

  /* ── FOOTER ── */
  .footer {
    padding: 28px 72px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Montserrat';
    font-size: 14px;
    color: var(--ink-mute);
    letter-spacing: 0.5px;
  }
  .footer-combo-logo {
    display: block;
    height: 36px;
    width: auto;
    opacity: 0.9;
  }
  .footer-aigc {
    font-family: 'PuHuiTi';
    font-weight: 400;
    letter-spacing: 1px;
  }
</style>
</head>
<body>
<div class="poster">

  <!-- HERO -->
  <section class="hero{% if hero_image %} hero--with-image{% endif %}">
    {% if hero_image %}
      <div class="hero-cover" style="background-image: url('{{ hero_image }}');"></div>
    {% elif hero_stat %}
      <div class="hero-stat">{{ hero_stat }}</div>
    {% endif %}
    <div class="hero-top">
      <span>{{ date_str_en }}</span>
      <span class="hero-brand-zh">异乡早咖啡 · {{ issue_no }}</span>
    </div>
    <div class="hero-kicker">今日要闻 · Today's Headline</div>
    <h1 class="hero-title">{{ hero_title_html }}</h1>
    <div class="hero-en">{{ hero.title_en }}</div>
    {% if hero.summary %}
    <div class="hero-summary">{{ hero_summary_html }}</div>
    {% endif %}
    <div class="hero-punch">{{ hero_punch_html }}</div>
    <div class="hero-source">SOURCE · {{ hero.source }}</div>
  </section>

  <!-- SECTION -->
  <div class="section-head">
    <div class="section-bar"></div>
    <div class="section-title">今日其他要闻</div>
    <div class="section-sub">{{ date_str }}</div>
  </div>

  <!-- NEWS LIST -->
  <div class="news-list">
    {% for item in items_html %}
    <div class="news-item">
      <div class="news-num">{{ '%02d' % (loop.index + 1) }}</div>
      <div class="news-body">
        <div class="news-title-zh">{{ item.title_zh_html }}</div>
        <div class="news-title-en">{{ item.title_en }}</div>
        <div class="news-summary">{{ item.summary_html }}</div>
        <div class="news-source">SOURCE · {{ item.source }}</div>
      </div>
    </div>
    {% endfor %}
  </div>

  <!-- BRAND BAR -->
  <div class="brand-bar">
    <div class="brand-cell brand--uhomes">
      <div class="brand-text">
        <div class="brand-tag">Scan · 扫码</div>
        {% if logo_uhomes %}
          <img class="brand-logo" src="{{ logo_uhomes }}" alt="异乡好居">
        {% else %}
          <div class="brand-name">异乡好居</div>
        {% endif %}
        <div class="brand-slogan">留学生海外的家</div>
      </div>
      <div class="qr">
        {% if qr_uhomes %}<img src="{{ qr_uhomes }}" alt="异乡好居小程序码">{% endif %}
      </div>
    </div>
    <div class="brand-divider"></div>
    <div class="brand-cell brand-cell--right brand--pay">
      <div class="brand-text">
        <div class="brand-tag">Scan · 扫码</div>
        {% if logo_pay %}
          <img class="brand-logo" src="{{ logo_pay }}" alt="异乡缴费">
        {% else %}
          <div class="brand-name">异乡缴费</div>
        {% endif %}
        <div class="brand-slogan">比一比 更省钱</div>
      </div>
      <div class="qr">
        {% if qr_pay %}<img src="{{ qr_pay }}" alt="异乡缴费小程序码">{% endif %}
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    {% if logo_combo %}
      <img class="footer-combo-logo" src="{{ logo_combo }}" alt="异乡好居 × 异乡缴费">
    {% else %}
      <div>Powered by 异乡有你</div>
    {% endif %}
    <div class="footer-aigc">AI 辅助生成 · 异乡早咖啡</div>
  </div>

</div>
</body>
</html>
