# LLM API 配置（必需，OpenAI 兼容协议）
# 默认接火山方舟 Ark 上的 DeepSeek v3.2；也可改回 api.deepseek.com 官方
DEEPSEEK_API_KEY=your_api_key_here
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=deepseek-v3-2-251201
# 切回 DeepSeek 官方时改为:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 企业微信Webhook (支持多个，用逗号分隔)
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=key1,https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=key2_here

# 天行数据API配置（可选，用于获取真实新闻）
TIANAPI_KEY=your_tianapi_key_here

# NewsAPI（可选）
NEWSAPI_KEY=your_newsapi_key_here

# 激活的主题板块（逗号分隔）
# 可用: ai, finance, startup, study_abroad, market_data, industry_news, edu_policy, uni_rankings, education, pbsa, uhomes
# 兼容别名: edu_market -> market_data, competitors -> industry_news
ACTIVE_TOPICS=study_abroad,market_data,industry_news,edu_policy,uni_rankings

# 可选：当所有主题“无新内容”时也发送日报（默认0）
SEND_WHEN_NO_NEW=0
