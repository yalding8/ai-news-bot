# ========== Gmail 邮件推送配置示例 ==========

# SMTP服务器配置（Gmail固定配置，不需要修改）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 【需要修改】你的Gmail地址
SMTP_USER=yalding8@gmail.com

# 【需要修改】应用专用密码（16位，去掉空格）
# 获取方式：https://myaccount.google.com/apppasswords
SMTP_PASSWORD=zfxxvtwwdqkyiree

# 发件人（通常和SMTP_USER相同）
EMAIL_FROM=yalding8@gmail.com

# 【可选修改】收件人（可以是任何邮箱，默认发给自己）
EMAIL_TO=eduagent@uhomes.com

# 【已有配置】DeepSeek API
DEEPSEEK_API_KEY=sk-192e98a7652b4a829754a3e740f3f0c2
